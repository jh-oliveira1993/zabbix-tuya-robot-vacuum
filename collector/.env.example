# Tuya + Zabbix configuration
# Copy this file to .env and fill in your values.
# Source it before running the collector:
#   source .env && python tuya_zabbix.py

# ── Tuya Device ──────────────────────────────────────────────────────────────
# Device ID as shown in the Tuya Developer Platform → Devices tab
TUYA_DEVICE_ID=YOUR_DEVICE_ID_HERE

# Local IP address of the vacuum on your LAN
TUYA_DEVICE_IP=192.168.15.XXX

# 16-character AES key retrieved via: python -m tinytuya wizard
TUYA_LOCAL_KEY=YOUR_16_CHAR_KEY_HERE

# Tuya protocol version (KaBuM Smart 900 uses 3.3)
TUYA_PROTOCOL_VERSION=3.3

# Device response timeout in seconds
TUYA_DEVICE_TIMEOUT=10

# ── Zabbix Proxy / Server ─────────────────────────────────────────────────────
# IP or hostname of the Zabbix Proxy (or Server) receiving trapper data
ZABBIX_PROXY_HOST=192.168.15.93

# Trapper port (default 10051)
ZABBIX_PROXY_PORT=10051

# ── Zabbix Host & Item ────────────────────────────────────────────────────────
# Must match exactly the host name configured in the Zabbix frontend
ZABBIX_HOST_NAME=KaBuM-Smart-900

# Master trapper item key (must match the template definition)
ZABBIX_ITEM_KEY=tuya.vacuum.raw

# Absolute path to the zabbix_sender binary
ZABBIX_SENDER_BIN=/usr/bin/zabbix_sender
